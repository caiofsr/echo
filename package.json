    "db:migrate": "bun scripts/migrate.ts",
    "auth:password": "bun scripts/password.ts",
    "auth:generate": "bunx --bun auth@latest generate --config ./src/lib/auth.ts --output ./src/db/schema.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
