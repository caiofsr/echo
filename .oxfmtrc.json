{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "node_modules",
    "dist",
    "bun.lock",
    "src/routeTree.gen.ts",
    "drizzle/meta",
    "docs/prototypes",
    "docs/planning/artifacts",
    ".claude",
    ".codex",
    ".intent",
    ".impeccable/config.json",
    "AGENTS.md",
    "PRODUCT.md"
  ]
}
